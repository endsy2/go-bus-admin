# Production Environment Variables
# These are used when building for production

# Backend API URL (without /api suffix - it's added in axiosConfig)
REACT_APP_BASE_URL=https://go-bus-gateway-service-production.up.railway.app

# WebSocket URL (use wss:// for secure WebSocket)
REACT_APP_WS_URL=wss://go-bus-gateway-service-production.up.railway.app/bus-service/ws/bus
