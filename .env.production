# Production Environment Variables
# Replace these with your actual production URLs

# Backend API URL (without /api suffix - it's added in axiosConfig)
REACT_APP_BASE_URL=http://your-backend-ip:8080

# WebSocket URL
REACT_APP_WS_URL=http://your-backend-ip:8080/bus-service/ws/bus

# Alternative: If using domain name
# REACT_APP_BASE_URL=https://api.yourdomain.com
# REACT_APP_WS_URL=wss://api.yourdomain.com/bus-service/ws/bus
